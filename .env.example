# C 端构建期变量（vite 只在 import.meta.env 注入 VITE_ 前缀）
#
# H5 开发：留空即可，走 vite 代理（/api、/static/remote → 127.0.0.1:8088）
# 小程序：必须是绝对地址，否则 uni.request/uni.uploadFile 无同源可用
#   VITE_API_BASE_URL=https://api.example.com/api
VITE_API_BASE_URL=

# H5 生产构建没有 vite 代理，/static/remote/** 需要能拿到图：
#   1) 部署层 nginx 反代 /static/remote → API（推荐，留空即可）
#   2) 或把媒体放独立域名/CDN，在这里填 origin（末尾不带斜杠）
#   VITE_MEDIA_ORIGIN=https://img.example.com
VITE_MEDIA_ORIGIN=
