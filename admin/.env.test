# backend service base url, test environment
VITE_SERVICE_BASE_URL=https://mock.apifox.cn/m1/3109515-0-default

# other backend service base url, test environment
VITE_OTHER_SERVICE_BASE_URL= `{
  "demo": "http://localhost:9528"
}`

# the mira admin api base url (Go backend :8088, relative so the dev proxy works over LAN/IPv6)
VITE_ADMIN_API_BASE_URL=/api/admin/v1

# 本项目没有 /route/getUserRoutes（模板自带 apifox mock 会 401），且 super 角色过滤只对静态路由生效
VITE_AUTH_ROUTE_MODE=static
# 后端 token 失效返回 401（不是模板默认的 403），403 留给权限不足
VITE_SERVICE_EXPIRED_TOKEN_CODES=401
