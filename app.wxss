page{background-color:#0c0d14;min-height:100vh;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Helvetica Neue,Arial,sans-serif;font-size:28rpx;color:#f8fafc;line-height:1.5}html,body,#app,uni-page,uni-page-wrapper,uni-page-body,uni-app,uni-app-body{background:#0c0d14;min-height:100vh}html,body,#app{color-scheme:dark;margin:0}view,text{box-sizing:border-box}.container{padding:24rpx}.flex{display:flex}.flex-col{flex-direction:column}.items-center{align-items:center}.justify-center{justify-content:center}.justify-between{justify-content:space-between}.flex-wrap{flex-wrap:wrap}.flex-1{flex:1}.gap-xs{gap:8rpx}.gap-sm{gap:16rpx}.gap-md{gap:24rpx}.gap-lg{gap:32rpx}.text-center{text-align:center}.text-primary{color:#ff6b00}.text-secondary{color:#94a3b8}.text-tertiary{color:#64748b}.text-sm{font-size:24rpx}.text-base{font-size:28rpx}.text-lg{font-size:36rpx}.text-xl{font-size:44rpx}.font-bold{font-weight:600}.mt-xs{margin-top:8rpx}.mt-sm{margin-top:16rpx}.mt-md{margin-top:24rpx}.mt-lg{margin-top:32rpx}.mb-xs{margin-bottom:8rpx}.mb-sm{margin-bottom:16rpx}.mb-md{margin-bottom:24rpx}.mb-lg{margin-bottom:32rpx}.card{background:#151722;border-radius:28rpx;padding:24rpx;box-shadow:0 4rpx 16rpx rgba(0,0,0,.35),0 0 0 1rpx rgba(255,255,255,.05)}.btn-primary{background:#ff6b00;color:#fff;border-radius:20rpx;padding:16rpx 32rpx;text-align:center;font-size:28rpx;font-weight:500}.btn-primary:active{background:#e05a00}.btn-outline{background:transparent;color:#ff6b00;border:2rpx solid #ff6b00;border-radius:20rpx;padding:16rpx 32rpx;text-align:center;font-size:28rpx}.btn-outline:active{background:rgba(255,107,0,.1)}.tag{display:inline-flex;align-items:center;padding:8rpx 16rpx;border-radius:12rpx;font-size:20rpx}.tag-primary{background:rgba(255,107,0,.1);color:#ff6b00}.tag-success{background:rgba(16,185,129,.1);color:#10b981}.tag-warning{background:rgba(251,191,36,.1);color:#fbbf24}.avatar{border-radius:50%;overflow:hidden}.ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ellipsis-2{overflow:hidden;text-overflow:ellipsis;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
page{--status-bar-height:25px;--top-window-height:0px;--window-top:0px;--window-bottom:0px;--window-left:0px;--window-right:0px;--window-magin:0px}[data-c-h="true"]{display: none !important;}