# 复制为 server/.env 后按本机情况调整；下面的端口是 docker-compose.yml 的**宿主**映射端口。
#   postgres: 宿主 5433 -> 容器 5432
#   redis:    宿主 6380 -> 容器 6379
# 后端跑在宿主上（go run ./cmd/api）时必须用宿主端口；容器内运行用容器端口（compose 里已设好）。
DB_HOST=localhost
DB_PORT=5433
DB_USER=comic
DB_PASSWORD=comic123
DB_NAME=comic

REDIS_HOST=localhost
REDIS_PORT=6380

# 前端 vite 代理指向 http://127.0.0.1:8088，后端跑宿主时用 8088
SERVER_PORT=8088

ALLCPP_BASE_URL=https://www.allcpp.cn

# development | production。production 会关闭演示用的手机号验证码登录（只允许微信登录）。
APP_ENV=development

# 微信小程序登录（wx.login -> code2session）。
# 留空时后端使用 mock 客户端，只接受 mock_ 开头的 code，方便本地/H5 联调。
# 生产必须填真实值，并在小程序后台配置 request 域名。
WX_APPID=
WX_APP_SECRET=
WX_API_BASE=https://api.weixin.qq.com

# false = 连真实 PostgreSQL/Redis（开发默认）；true = 不连库、直接返回种子数据，便于无依赖演示
USE_MOCK=false

# 微信订阅消息（三张模板 ID 在 mp.weixin.qq.com → 功能 → 订阅消息 里拿）
WX_TMPL_NEW_BOOKING=收到预约通知的模板ID
WX_TMPL_RESULT=预约结果通知的模板ID
WX_TMPL_DELIVERED=相册交付状态通知的模板ID
# 字段 ID 顺序（提交模板后详情页能看到 thing1/time2/amount3），逗号分隔，顺序必须与后台关键词一致
WX_FIELDS_NEW_BOOKING=time2,thing3,thing4,thing1
WX_FIELDS_RESULT=thing1,thing2,time3,thing7,character_string15
WX_FIELDS_DELIVERED=thing1,time2,thing3
# developer / trial / formal
WX_MP_STATE=formal
